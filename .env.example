# ==============================================================================
# TexLink Factory OS — Production Environment Configuration for Altare
# Template with secure placeholders. NEVER commit actual production secrets.
# ==============================================================================

# Node Environment
NODE_ENV="production"
PORT=3000

# ------------------------------------------------------------------------------
# 1. Database Configuration (Managed PostgreSQL 14+ on Altare / Cloud)
# ------------------------------------------------------------------------------
# For PgBouncer / Transaction pooler:
DATABASE_URL="postgresql://texlink_user:CHANGE_ME_PASSWORD@postgres.internal:5432/texlink_prod?schema=public&sslmode=require&pgbouncer=true"

# Direct non-pooling connection used strictly for Prisma migrations:
DIRECT_URL="postgresql://texlink_user:CHANGE_ME_PASSWORD@postgres.internal:5432/texlink_prod?schema=public&sslmode=require"

# (For local testing / dev SQLite fallback):
# DATABASE_URL="file:./dev.db"

# ------------------------------------------------------------------------------
# 2. Authentication & Session Security (JWT)
# ------------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
JWT_SECRET="CHANGE_ME_IN_PRODUCTION_MIN_32_CHAR_RANDOM_HEX_OR_BASE64_KEY"

# Public application base URL (Custom domain or Altare app URL)
NEXT_PUBLIC_APP_URL="https://texlink.example.com"

# ------------------------------------------------------------------------------
# 3. Persistent Object Storage (Supabase / Altare S3-Compatible Storage)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."

# ------------------------------------------------------------------------------
# 4. Email & Notification Services
# ------------------------------------------------------------------------------
RESEND_API_KEY="re_live_production_key"
