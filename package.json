{
  "name": "texlink-egypt",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:altare": "node scripts/build.js",
    "start": "next start",
    "lint": "next lint",
    "db:push": "prisma db push --schema=prisma/schema.prisma",
    "db:generate": "prisma generate --schema=prisma/schema.prisma",
    "db:generate:postgres": "prisma generate --schema=prisma/schema.postgresql.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema=prisma/schema.postgresql.prisma",
    "db:migrate:deploy:postgres": "prisma migrate deploy --schema=prisma/schema.postgresql.prisma",
    "db:migrate:deploy:sqlite": "prisma migrate deploy --config prisma/sqlite.config.mjs",
    "db:migrate:status": "prisma migrate status --schema=prisma/schema.postgresql.prisma",
    "db:migrate:status:postgres": "prisma migrate status --schema=prisma/schema.postgresql.prisma",
    "db:migrate:status:sqlite": "prisma migrate status --config prisma/sqlite.config.mjs",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:demo": "tsx prisma/seed-demo.ts",
    "test": "vitest run",
    "jwt:generate": "node scripts/generate-jwt-secret.js",
    "deploy:worker": "cd cloudflare-worker && npx wrangler deploy"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@supabase/supabase-js": "^2.119.0",
    "@types/pg": "^8.23.1",
    "bcryptjs": "^3.0.2",
    "clsx": "^2.1.1",
    "ioredis": "^6.1.0",
    "jose": "^5.9.6",
    "lucide-react": "^0.475.0",
    "next": "^15.5.29",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@netlify/plugin-nextjs": "^5.16.6",
    "@playwright/test": "^1.65.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/ioredis": "^4.28.10",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "eslint": "8.57.1",
    "eslint-config-next": "15.2.0",
    "postcss": "^8.5.2",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
