datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  phone        String
  role         String    @default("BUYER") // "BUYER", "FACTORY", "ADMIN"
  isFactory    Boolean   @default(false)
  isBuyer      Boolean   @default(true)
  avatarUrl    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  factoryProfile       FactoryProfile?
  buyerProfile         BuyerProfile?
  rfqs                 Rfq[]
  ordersAsBuyer        Order[]          @relation("BuyerOrders")
  sentMessages         Message[]        @relation("SentMessages")
  reviews              Review[]         @relation("UserReviews")
  notifications        Notification[]
  auditLogs            AuditLog[]
  conversationsAsBuyer Conversation[]   @relation("BuyerConversations")
  crmCustomers         CrmCustomer[]    @relation("CrmBuyer")
}

model FactoryProfile {
  id                 String           @id @default(cuid())
  userId             String           @unique
  nameAr             String
  slug               String           @unique
  governorate        String
  city               String
  address            String           // Street address (masked until quote accepted)
  phone              String           // Factory phone (masked until quote accepted)
  whatsapp           String           // WhatsApp (masked until quote accepted)
  bioAr              String
  logoUrl            String?
  coverUrl           String?
  accountStatus      String           @default("ACTIVE") // "ACTIVE", "SUSPENDED"
  verificationStatus String           @default("PENDING") // "PENDING", "VERIFIED", "REJECTED"
  rejectionReason    String?
  verifiedAt         DateTime?
  minOrderQuantity   Int              @default(50)
  monthlyCapacity    Int              @default(5000)
  establishedYear    Int              @default(2015)
  rating             Float            @default(4.5)
  reviewCount        Int              @default(0)
  specialties        String           // JSON string array e.g. ["تيشيرتات", "بولو"]
  machines           String           // JSON string array e.g. ["ماكينات خياطة 4 فتلة"]
  fabrics            String           // JSON string array e.g. ["قطن 100%", "ميلتون"]
  gallery            String           @default("[]") // JSON string array of image URLs
  featured           Boolean          @default(false)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents          FactoryDocument[]
  products           Product[]
  quotes             Quote[]
  orders             Order[]          @relation("FactoryOrders")
  reviewsReceived    Review[]         @relation("FactoryReviews")
  conversations      Conversation[]

  // Factory OS relations
  settings              FactorySettings?
  machinesList          Machine[]
  factoryProducts       FactoryProduct[]
  productionOrders      ProductionOrder[]
  productionEntries     ProductionEntry[]
  wasteRecords          WasteRecord[]
  maintenanceTickets    MaintenanceTicket[]
  warehouses            Warehouse[]
  inventoryItems        InventoryItem[]
  stockMovements        StockMovement[]
  materialConsumptions  MaterialConsumption[]
  employees             Employee[]
  shifts                Shift[]
  attendanceRecords     AttendanceRecord[]
  suppliers             Supplier[]
  factoryPurchaseOrders FactoryPurchaseOrder[]
  expenses              Expense[]
  productionCosts       ProductionCost[]
  qualityInspections    QualityInspection[]

  // CRM Workspace relations
  crmCustomers          CrmCustomer[]
  crmLeads              CrmLead[]
  crmDeals              CrmDeal[]
  crmFollowUps          CrmFollowUp[]
  crmActivities         CrmActivity[]
}

model FactoryDocument {
  id         String         @id @default(cuid())
  factoryId  String
  type       String         // "COMMERCIAL_REGISTER", "TAX_CARD", "INDUSTRIAL_REGISTER", "OTHER"
  fileUrl    String
  fileName   String
  isPrivate  Boolean        @default(true) // Private documents served via authenticated route
  storageKey String?        // Server-side private storage key outside web root
  mimeType   String?
  fileSize   Int?
  status     String         @default("PENDING") // "PENDING", "APPROVED", "REJECTED"
  uploadedAt DateTime       @default(now())

  factory    FactoryProfile @relation(fields: [factoryId], references: [id], onDelete: Cascade)

  @@index([factoryId])
}

model BuyerProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  companyName  String
  businessType String   @default("WHOLESALER") // "WHOLESALER", "BRAND", "RETAILER", "INDIVIDUAL"
  governorate  String
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Category {
  id       String    @id @default(cuid())
  nameAr   String
  nameEn   String
  slug     String    @unique
  icon     String?

  products Product[]
  rfqs     Rfq[]
}

model Product {
  id            String             @id @default(cuid())
  factoryId     String
  categoryId    String
  nameAr        String
  descriptionAr String
  fabric        String
  gsm           Int?
  colors        String             @default("[]") // JSON string array
  sizes         String             @default("[]") // JSON string array
  moq           Int                @default(50)
  leadTimeDays  Int                @default(7)
  stockQuantity Int                @default(100)
  basePrice     Float
  images        String             @default("[]") // JSON string array
  isActive      Boolean            @default(true)
  isFeatured    Boolean            @default(false)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  factory       FactoryProfile     @relation(fields: [factoryId], references: [id], onDelete: Cascade)
  category      Category           @relation(fields: [categoryId], references: [id])
  priceTiers    ProductPriceTier[]
  orders        Order[]
}

model ProductPriceTier {
  id           String  @id @default(cuid())
  productId    String
  minQuantity  Int
  maxQuantity  Int?
  pricePerPiece Float

  product      Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Rfq {
  id                  String             @id @default(cuid())
  buyerId             String
  titleAr             String
  productType         String
  categoryId          String?
  totalQuantity       Int
  fabricDetails       String
  gsm                 Int?
  colors              String?
  printingEmbroidery  String?
  targetBudgetPerPiece Float?
  deadlineDays        Int                @default(15)
  deadlineDate        DateTime?
  sampleRequired      Boolean            @default(true)
  targetGovernorate   String?
  notesAr             String?
  status              String             @default("OPEN") // "DRAFT", "OPEN", "UNDER_REVIEW", "QUOTE_ACCEPTED", "IN_PRODUCTION", "SHIPPED", "COMPLETED", "CANCELLED", "EXPIRED"
  expiresAt           DateTime
  acceptedQuoteId     String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  buyer               User               @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  category            Category?          @relation(fields: [categoryId], references: [id])
  attachments         RfqAttachment[]
  sizeBreakdowns      RfqSizeBreakdown[]
  quotes              Quote[]
  order               Order?
  conversations       Conversation[]
  crmDeals            CrmDeal[]
}

model RfqAttachment {
  id       String @id @default(cuid())
  rfqId    String
  fileUrl  String
  fileType String
  fileName String

  rfq      Rfq    @relation(fields: [rfqId], references: [id], onDelete: Cascade)
}

model RfqSizeBreakdown {
  id       String  @id @default(cuid())
  rfqId    String
  size     String
  color    String?
  quantity Int

  rfq      Rfq     @relation(fields: [rfqId], references: [id], onDelete: Cascade)
}

model Quote {
  id                 String         @id @default(cuid())
  rfqId              String
  factoryId          String
  unitPrice          Float
  totalAmount        Float
  leadTimeDays       Int
  samplePrice        Float?
  sampleLeadTimeDays Int?
  minQuantity        Int
  paymentTermsAr     String
  notesAr            String?
  status             String         @default("PENDING") // "PENDING", "ACCEPTED", "REJECTED", "EXPIRED", "WITHDRAWN"
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  rfq                Rfq            @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  factory            FactoryProfile @relation(fields: [factoryId], references: [id], onDelete: Cascade)
  order              Order?
  conversation       Conversation?
}

model Order {
  id                  String           @id @default(cuid())
  orderNumber         String           @unique
  rfqId               String?          @unique
  quoteId             String?          @unique
  productId           String?
  buyerId             String
  factoryId           String
  totalAmount         Float
  quantity            Int
  unitPrice           Float
  paymentTerms        String
  status              String           @default("CONFIRMED") // "CONFIRMED", "SAMPLE_PENDING", "SAMPLE_APPROVED", "IN_PRODUCTION", "READY_FOR_SHIPPING", "SHIPPED", "DELIVERED", "CANCELLED"
  agreedDeliveryDate  DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  buyer               User             @relation("BuyerOrders", fields: [buyerId], references: [id])
  factory             FactoryProfile   @relation("FactoryOrders", fields: [factoryId], references: [id])
  rfq                 Rfq?             @relation(fields: [rfqId], references: [id])
  quote               Quote?           @relation(fields: [quoteId], references: [id])
  product             Product?         @relation(fields: [productId], references: [id])
  milestones          OrderMilestone[]
  reviews             Review[]
  conversation        Conversation?
  crmDeals            CrmDeal[]
}

model OrderMilestone {
  id          String    @id @default(cuid())
  orderId     String
  step        String    // "SAMPLE", "SAMPLE_APPROVAL", "PRODUCTION", "READY", "SHIPPED", "DELIVERED"
  titleAr     String
  status      String    @default("PENDING") // "PENDING", "IN_PROGRESS", "COMPLETED"
  completedAt DateTime?
  notes       String?

  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Conversation {
  id            String    @id @default(cuid())
  rfqId         String?
  orderId       String?   @unique
  quoteId       String?   @unique
  buyerId       String
  factoryId     String
  lastMessageAt DateTime  @default(now())
  createdAt     DateTime  @default(now())

  buyer         User           @relation("BuyerConversations", fields: [buyerId], references: [id], onDelete: Cascade)
  factory       FactoryProfile @relation(fields: [factoryId], references: [id], onDelete: Cascade)
  rfq           Rfq?           @relation(fields: [rfqId], references: [id])
  order         Order?         @relation(fields: [orderId], references: [id])
  quote         Quote?         @relation(fields: [quoteId], references: [id])
  messages      Message[]
}

model Message {
  id                  String       @id @default(cuid())
  conversationId      String
  senderId            String
  content             String
  containsContactInfo Boolean      @default(false)
  isMasked            Boolean      @default(false)
  attachments         String?      // JSON string
  createdAt           DateTime     @default(now())

  conversation        Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender              User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
}

model Review {
  id          String         @id @default(cuid())
  orderId     String
  authorId    String
  factoryId   String
  rating      Int            // 1 to 5
  commentAr   String
  createdAt   DateTime       @default(now())

  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  author      User           @relation("UserReviews", fields: [authorId], references: [id], onDelete: Cascade)
  factory     FactoryProfile @relation("FactoryReviews", fields: [factoryId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  titleAr   String
  bodyAr    String
  type      String   // "RFQ_MATCH", "QUOTE_RECEIVED", "QUOTE_ACCEPTED", "ORDER_STATUS", "MESSAGE"
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         String   @id @default(cuid())
  adminId    String
  action     String   // "VERIFY_FACTORY", "REJECT_FACTORY", "MODERATE_RFQ", etc.
  targetType String
  targetId   String
  details    String?  // JSON
  createdAt  DateTime @default(now())

  admin      User     @relation(fields: [adminId], references: [id], onDelete: Cascade)
}

// ==========================================
// FACTORY OS ERP DOMAIN MODELS
// ==========================================

model FactorySettings {
  id                      String         @id @default(cuid())
  factoryId               String         @unique
  usageMode               String         @default("FULL_ACCESS") // "MANAGEMENT_ONLY", "FULL_ACCESS"
  marketplaceEnabled      Boolean        @default(true)
  autoMatchEnabled        Boolean        @default(true)
  wasteThresholdPct       Float          @default(5.0)
  lowStockAlertThreshold  Int            @default(50)
  workingHoursPerShift    Float          @default(8.0)
  currency                String         @default("EGP")
  traceabilityEnabled     Boolean        @default(true)
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  factory                 FactoryProfile @relation(fields: [factoryId], references: [id], onDelete: Cascade)
}

model Machine {
  id                      String              @id @default(cuid())
  factoryId               String
  code                    String
  name                    String
  type                    String              // CIRCULAR_KNITTING, FLAT_KNITTING, OVERLOCK, SEWING_SINGER, CUTTING_LASER, IRONING, EMBROIDERY, OTHER
  brand                   String
  model                   String?
  serialNumber            String?
  purchaseDate            DateTime?
  purchaseCost            Float?
  status                  String              @default("RUNNING") // RUNNING, STOPPED, UNDER_MAINTENANCE, OUT_OF_SERVICE
  maintenanceIntervalDays Int                 @default(30)
  lastMaintenanceDate     DateTime?
  hourlyOperatingCost     Float               @default(0)
  notes                   String?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  factory                 FactoryProfile      @relation(fields: [factoryId], references: [id], onDelete: Cascade)
  maintenanceTickets      MaintenanceTicket[]
  productionEntries       ProductionEntry[]
  wasteRecords            WasteRecord[]
  expenses                Expense[]

  @@unique([factoryId, code])
  @@index([factoryId])
}

model FactoryProduct {
  id                       String            @id @default(cuid())
  factoryId                String
  code                     String
  name                     String
  category                 String            // TSHIRT, POLO, HOODIE, SWEATER, SOCKS, UNDERWEAR, PANTS, OTHER
  fabricType               String
  gsm                      Int?
  sizes                    String            @default("[]")
  colors                   String            @default("[]")
  estimatedCost            Float             @default(0)
  standardPrice            Float             @default(0)
  imageUrl                 String?
  isPublishedToMarketplace Boolean           @default(false)
  marketplaceProductId     String?
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt

  factory                  FactoryProfile    @relation(fields: [factoryId], references: [id], onDelete: Cascade)
  productionOrders         ProductionOrder[]

  @@unique([factoryId, code])
  @@index([factoryId])
}

model ProductionOrder {
  id                   String                @id @default(cuid())
  factoryId            String
  orderNumber          String
  batchNumber          String?
  productId            String?
  productNameSnapshot  String
  targetQuantity       Int
  plannedStartDate     DateTime
  plannedEndDate       DateTime
  actualStartDate      DateTime?
  actualEndDate        DateTime?
  priority             String                @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  status               String                @default("PLANNED") // DRAFT, PLANNED, IN_PROGRESS, PAUSED, COMPLETED, CANCELLED
  notes                String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  factory              FactoryProfile        @relation(fields: [factoryId], references: [id], onDelete: Cascade)
  product              FactoryProduct?       @relation(fields: [productId], references: [id], onDelete: SetNull)
  productionEntries    ProductionEntry[]
  wasteRecords         WasteRecord[]
  materialConsumptions MaterialConsumption[]
  qualityInspections   QualityInspection[]
  productionCost       ProductionCost?
  expenses             Expense[]

  @@unique([factoryId, orderNumber])
  @@index([factoryId])
}

model ProductionEntry {
  id                String          @id @default(cuid())
  factoryId         String
  productionOrderId String
  machineId         String?
  employeeId        String?
  shiftId           String?
  stage             String          // MATERIAL_PREP, KNITTING, CUTTING, SEWING, PRINTING, EMBROIDERY, FINISHING, QUALITY_INSPECTION, PACKAGING
  productionDate    DateTime        @default(now())
  producedQuantity  Int
  goodQuantity      Int
  defectiveQuantity Int
  notes             String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  factory           FactoryProfile  @relation(fields: [factoryId], references: [id], onDelete: Cascade)
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  machine           Machine?        @relation(fields: [machineId], references: [id], onDelete: SetNull)
  employee          Employee?       @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  shift             Shift?          @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  wasteRecords      WasteRecord[]

  @@index([factoryId])
  @@index([productionOrderId])
}

model WasteRecord {
  id                  String           @id @default(cuid())
  factoryId           String
  productionOrderId   String?
  productionEntryId   String?
  machineId           String?
  stage               String
  defectType          String           // BROKEN_NEEDLE, KNITTING_DEFECT, FABRIC_DEFECT, SEWING_DEFECT, PRINTING_DEFECT, SIZE_MISMATCH, OIL_STAIN, MATERIAL_DAMAGE, OTHER
  quantity            Int
  reworkQuantity      Int              @default(0)
  reworkAccepted      Int              @default(0)
  scrappedQuantity    Int              @default(0)
  estimatedCost       Float            @default(0)
  notes               String?
  createdAt           DateTime         @default(now())

  factory             FactoryProfile   @relation(fields: [factoryId], references: [id], onDelete: Cascade)
  productionOrder     ProductionOrder? @relation(fields: [productionOrderId], references: [id], onDelete: SetNull)
  productionEntry     ProductionEntry? @relation(fields: [productionEntryId], references: [id], onDelete: SetNull)
  machine             Machine?         @relation(fields: [machineId], references: [id], onDelete: SetNull)

  @@index([factoryId])
}

model MaintenanceTicket {
  id                  String         @id @default(cuid())
  factoryId           String
  machineId           String
  issueType           String         // NEEDLE_BREAKAGE, MOTOR_FAILURE, BELT_WEAR, ELECTRICAL, SCHEDULED_PREVENTIVE, CALIBRATION, OTHER
  priority            String         @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  description         String
  startTime           DateTime       @default(now())
  endTime             DateTime?
  downtimeMinutes     Int            @default(0)
  sparePartsUsed      String?
  laborCost           Float          @default(0)
  sparePartsCost      Float          @default(0)
  totalCost           Float          @default(0)
  status              String         @default("OPEN") // OPEN, IN_PROGRESS, WAITING_FOR_PARTS, RESOLVED, CLOSED
  resolvedBy          String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  factory             FactoryProfile @relation(fields: [factoryId], references: [id], onDelete: Cascade)
  machine             Machine        @relation(fields: [machineId], references: [id], onDelete: Cascade)

  @@index([factoryId])
  @@index([machineId])
}

model Warehouse {
  id                  String          @id @default(cuid())
  factoryId           String
  name                String
  location            String?
  type                String          @default("RAW_MATERIALS") // RAW_MATERIALS, FINISHED_GOODS, SPARE_PARTS, WIP
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  factory             FactoryProfile  @relation(fields: [factoryId], references: [id], onDelete: Cascade)
  items               InventoryItem[]
  sourceMovements     StockMovement[] @relation("FromWarehouse")
  targetMovements     StockMovement[] @relation("ToWarehouse")

  @@index([factoryId])
}

model InventoryItem {
  id                  String                @id @default(cuid())
  factoryId           String
  warehouseId         String
  name                String
  sku                 String?
  batchNumber         String?
  category            String                // YARN, FABRIC, NEEDLES, SPARE_PARTS, ACCESSORIES, PACKAGING, FINISHED_GOODS
  unit                String                // KG, METERS, PIECES, ROLLS, BOXES
  currentStock        Float                 @default(0)
  minimumStock        Float                 @default(10)
  unitCost            Float                 @default(0)
  totalValuation      Float                 @default(0)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  factory             FactoryProfile        @relation(fields: [factoryId], references: [id], onDelete: Cascade)
  warehouse           Warehouse             @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  movements           StockMovement[]
  consumptions        MaterialConsumption[]
  purchaseItems       FactoryPurchaseItem[]

  @@index([factoryId])
  @@index([warehouseId])
}

model StockMovement {
  id                   String         @id @default(cuid())
  factoryId            String
  inventoryItemId      String
  movementType         String         // PURCHASE_IN, PRODUCTION_ISSUE, PRODUCTION_RETURN, ADJUSTMENT_IN, ADJUSTMENT_OUT, TRANSFER_IN, TRANSFER_OUT
  quantity             Float
  previousStock        Float
  newStock             Float
  unitCost             Float          @default(0)
  fromWarehouseId      String?
  toWarehouseId        String?
  referenceOrderNumber String?
  idempotencyKey       String?
  notes                String?
  createdAt            DateTime       @default(now())

  factory              FactoryProfile @relation(fields: [factoryId], references: [id], onDelete: Cascade)
  inventoryItem        InventoryItem  @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  fromWarehouse        Warehouse?     @relation("FromWarehouse", fields: [fromWarehouseId], references: [id])
  toWarehouse          Warehouse?     @relation("ToWarehouse", fields: [toWarehouseId], references: [id])

  @@index([factoryId])
  @@index([inventoryItemId])
}

model MaterialConsumption {
  id                String          @id @default(cuid())
  factoryId         String
  productionOrderId String
  inventoryItemId   String
  plannedQuantity   Float
  issuedQuantity    Float           @default(0)
  returnedQuantity  Float           @default(0)
  actualConsumed    Float           @default(0)
  unitCost          Float           @default(0)
  totalCost         Float           @default(0)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  factory           FactoryProfile  @relation(fields: [factoryId], references: [id], onDelete: Cascade)
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  inventoryItem     InventoryItem   @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([factoryId])
  @@index([productionOrderId])
}

model Employee {
  id                String             @id @default(cuid())
  factoryId         String
  code              String
  name              String
  jobTitle          String
  phone             String?
  hiringDate        DateTime?
  monthlySalary     Float              @default(0)
  paymentType       String             @default("MONTHLY") // MONTHLY, DAILY, PRODUCTION_PIECE
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  factory           FactoryProfile     @relation(fields: [factoryId], references: [id], onDelete: Cascade)
  productionEntries ProductionEntry[]
  attendanceRecords AttendanceRecord[]

  @@unique([factoryId, code])
  @@index([factoryId])
}

model Shift {
  id                String             @id @default(cuid())
  factoryId         String
  name              String             // وردية صباحية، وردية مسائية، وردية ليلية
  startTime         String
  endTime           String
  hours             Float              @default(8.0)
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  factory           FactoryProfile     @relation(fields: [factoryId], references: [id], onDelete: Cascade)
  productionEntries ProductionEntry[]
  attendanceRecords AttendanceRecord[]

  @@index([factoryId])
}

model AttendanceRecord {
  id            String         @id @default(cuid())
  factoryId     String
  employeeId    String
  shiftId       String?
  date          DateTime
  checkIn       String?
  checkOut      String?
  status        String         @default("PRESENT") // PRESENT, ABSENT, LATE, OVERTIME, LEAVE
  overtimeHours Float          @default(0)
  createdAt     DateTime       @default(now())

  factory       FactoryProfile @relation(fields: [factoryId], references: [id], onDelete: Cascade)
  employee      Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shift         Shift?         @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  @@index([factoryId])
  @@index([employeeId])
}

model Supplier {
  id                 String                 @id @default(cuid())
  factoryId          String
  name               String
  category           String                 // YARN, FABRIC, ACCESSORIES, DYES, PACKAGING, SPARE_PARTS
  contactPerson      String?
  phone              String
  address            String?
  outstandingBalance Float                  @default(0)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  factory            FactoryProfile         @relation(fields: [factoryId], references: [id], onDelete: Cascade)
  purchaseOrders     FactoryPurchaseOrder[]

  @@index([factoryId])
}

model FactoryPurchaseOrder {
  id                   String                @id @default(cuid())
  factoryId            String
  supplierId           String
  poNumber             String
  orderDate            DateTime              @default(now())
  expectedDeliveryDate DateTime?
  status               String                @default("PENDING") // PENDING, PARTIALLY_RECEIVED, RECEIVED, CANCELLED
  totalAmount          Float                 @default(0)
  notes                String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  factory              FactoryProfile        @relation(fields: [factoryId], references: [id], onDelete: Cascade)
  supplier             Supplier              @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  items                FactoryPurchaseItem[]

  @@unique([factoryId, poNumber])
  @@index([factoryId])
}

model FactoryPurchaseItem {
  id              String               @id @default(cuid())
  purchaseOrderId String
  inventoryItemId String?
  description     String
  quantity        Float
  receivedQuantity Float               @default(0)
  unitPrice       Float
  totalPrice      Float

  purchaseOrder   FactoryPurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  inventoryItem   InventoryItem?       @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)
}

model Expense {
  id                      String           @id @default(cuid())
  factoryId               String
  category                String           // ELECTRICITY, MAINTENANCE, LABOR, RENT, TRANSPORTATION, RAW_MATERIALS, SPARE_PARTS, OTHER
  amount                  Float
  date                    DateTime         @default(now())
  paymentMethod           String           @default("CASH")
  description             String
  relatedMachineId        String?
  relatedProductionOrderId String?
  receiptUrl              String?
  createdAt               DateTime         @default(now())

  factory                 FactoryProfile   @relation(fields: [factoryId], references: [id], onDelete: Cascade)
  relatedMachine          Machine?         @relation(fields: [relatedMachineId], references: [id], onDelete: SetNull)
  relatedProductionOrder  ProductionOrder? @relation(fields: [relatedProductionOrderId], references: [id], onDelete: SetNull)

  @@index([factoryId])
}

model ProductionCost {
  id                String          @id @default(cuid())
  factoryId         String
  productionOrderId String          @unique
  materialCost      Float           @default(0)
  directLaborCost   Float           @default(0)
  machineCost       Float           @default(0)
  maintenanceCost   Float           @default(0)
  overheadCost      Float           @default(0)
  totalCost         Float           @default(0)
  goodUnitsCount    Int             @default(0)
  costPerGoodUnit   Float           @default(0)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  factory           FactoryProfile  @relation(fields: [factoryId], references: [id], onDelete: Cascade)
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)

  @@index([factoryId])
}

model QualityInspection {
  id                String          @id @default(cuid())
  factoryId         String
  productionOrderId String
  stage             String
  inspectedQuantity Int
  acceptedQuantity  Int
  rejectedQuantity  Int
  reworkQuantity    Int             @default(0)
  defectReasons     String?
  status            String          @default("PASSED") // PASSED, PASSED_WITH_CONDITIONS, REJECTED
  inspectorName     String?
  inspectionDate    DateTime        @default(now())
  createdAt         DateTime        @default(now())

  factory           FactoryProfile  @relation(fields: [factoryId], references: [id], onDelete: Cascade)
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)

  @@index([factoryId])
  @@index([productionOrderId])
}
// ==========================================
// CRM WORKSPACE DOMAIN MODELS
// ==========================================

model CrmCustomer {
  id               String         @id @default(cuid())
  factoryId        String
  buyerId          String?        // Link to marketplace User/Buyer
  name             String
  companyName      String?
  email            String?
  phone            String
  whatsapp         String?
  governorate      String?
  city             String?
  address          String?
  source           String         @default("MARKETPLACE") // MARKETPLACE, DIRECT, REFERRAL, MANUAL, EXHIBITION
  status           String         @default("ACTIVE")      // LEAD, PROSPECT, ACTIVE, INACTIVE
  tags             String         @default("[]")          // JSON string array e.g. ["كبار العملاء", "تصدير"]
  notes            String?
  totalSpend       Float          @default(0)
  ordersCount      Int            @default(0)
  lastContactDate  DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  factory          FactoryProfile @relation(fields: [factoryId], references: [id], onDelete: Cascade)
  buyer            User?          @relation("CrmBuyer", fields: [buyerId], references: [id], onDelete: SetNull)
  leads            CrmLead[]
  deals            CrmDeal[]
  followUps        CrmFollowUp[]
  activities       CrmActivity[]

  @@index([factoryId])
  @@index([buyerId])
}

model CrmLead {
  id               String         @id @default(cuid())
  factoryId        String
  customerId       String?
  title            String
  contactName      String
  phone            String
  email            String?
  estimatedValue   Float?
  productInterest  String?
  source           String         @default("MARKETPLACE") // MARKETPLACE_RFQ, DIRECT_CALL, WHATSAPP, WEBSITE
  status           String         @default("NEW")         // NEW, CONTACTED, QUALIFIED, UNQUALIFIED, CONVERTED
  notes            String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  factory          FactoryProfile @relation(fields: [factoryId], references: [id], onDelete: Cascade)
  customer         CrmCustomer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  deals            CrmDeal[]
  followUps        CrmFollowUp[]

  @@index([factoryId])
  @@index([customerId])
}

model CrmDeal {
  id                String         @id @default(cuid())
  factoryId         String
  customerId        String
  leadId            String?
  rfqId             String?        // Link to Marketplace RFQ
  orderId           String?        // Link to Marketplace Order
  title             String
  stage             String         @default("DISCOVERY") // DISCOVERY, PROPOSAL, NEGOTIATION, WON, LOST
  amount            Float          @default(0)
  expectedCloseDate DateTime?
  notes             String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  factory           FactoryProfile @relation(fields: [factoryId], references: [id], onDelete: Cascade)
  customer          CrmCustomer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  lead              CrmLead?       @relation(fields: [leadId], references: [id], onDelete: SetNull)
  rfq               Rfq?           @relation(fields: [rfqId], references: [id], onDelete: SetNull)
  order             Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  followUps         CrmFollowUp[]
  activities        CrmActivity[]

  @@index([factoryId])
  @@index([customerId])
  @@index([rfqId])
  @@index([orderId])
}

model CrmFollowUp {
  id          String         @id @default(cuid())
  factoryId   String
  customerId  String?
  dealId      String?
  leadId      String?
  title       String
  dueDate     DateTime
  type        String         @default("CALL")   // CALL, MEETING, EMAIL, QUOTE_FOLLOWUP, SAMPLE_DELIVERY
  priority    String         @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  status      String         @default("PENDING") // PENDING, COMPLETED, CANCELLED
  completedAt DateTime?
  assignedTo  String?
  notes       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  factory     FactoryProfile @relation(fields: [factoryId], references: [id], onDelete: Cascade)
  customer    CrmCustomer?   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  deal        CrmDeal?       @relation(fields: [dealId], references: [id], onDelete: SetNull)
  lead        CrmLead?       @relation(fields: [leadId], references: [id], onDelete: SetNull)
  @@index([factoryId])
  @@index([dueDate])
  @@index([status])
}

model CrmActivity {
  id          String         @id @default(cuid())
  factoryId   String
  customerId  String
  dealId      String?
  type        String         // NOTE, CALL, MEETING, MARKETPLACE_ORDER, MARKETPLACE_RFQ, QUOTATION_SENT, EMAIL
  description String
  performedBy String?
  createdAt   DateTime       @default(now())

  factory     FactoryProfile @relation(fields: [factoryId], references: [id], onDelete: Cascade)
  customer    CrmCustomer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  deal        CrmDeal?       @relation(fields: [dealId], references: [id], onDelete: SetNull)

  @@index([factoryId])
  @@index([customerId])
}
